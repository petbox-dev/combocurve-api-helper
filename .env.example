# Copy to .env (gitignored) and fill in. Read by tests/conftest.py for the live tests,
# which also need CC_LIVE_TEST=1 and the dev credentials in ~/.combocurve/dev/.
CC_DEV_PROJECT_ID=
CC_DEV_SCENARIO_ID=
CC_DEV_DATES_MODEL_ID=

# Type Curve 2.0 live test (tests/test_type_curves_v2_live.py), on dev: a type curve of CC_DEV_PROJECT_ID
# with fits on every phase, a normalization and at least 10 wells (read only). The test writes throwaway
# objects named "API Helper Fixture *" in that project and deletes them.
CC_DEV_TYPE_CURVE_ID=

# Econ settings live test (tests/test_econ_settings_live.py): a real econ column key and its category,
# e.g. "Cash Flow" / "net_income". The test writes "API Helper Fixture *" econ settings and deletes them.
CC_DEV_ECON_CATEGORY=
CC_DEV_ECON_COLUMN_KEY=
